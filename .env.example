# ============================================================================
# PRODUCTION READY ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================================

# Server Configuration
NODE_ENV=production
PORT=3000

# ============================================================================
# SECURITY - REQUIRED FOR PRODUCTION
# ============================================================================

# JWT Secret for token signing - MUST be at least 32 characters in production
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-this

# CORS Origins - Comma-separated list of allowed origins
# For development: http://localhost:3000,http://127.0.0.1:3000
# For production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# AI/LLM Configuration
# ============================================================================

# Google Gemini API Key - Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key-here

# Model selection (optional, defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# ============================================================================
# EXTERNAL API KEYS (Optional - for enhanced recommendations)
# ============================================================================

# TMDB API Key for movie recommendations: https://www.themoviedb.org/settings/api
# If not provided, app will fall back to TVMaze API
TMDB_API_KEY=optional-tmdb-key-for-enhanced-movies

# ============================================================================
# NOTES
# ============================================================================
# - All API keys should be kept strictly private
# - In Vercel: Go to Settings → Environment Variables and add these vars
# - In Render/Heroku: Use the dashboard to set environment variables
# - Never expose JWT_SECRET or GEMINI_API_KEY in frontend code
# - Change JWT_SECRET immediately after initial setup
